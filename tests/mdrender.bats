#!/usr/bin/env bats

# mdrender.bats — end-to-end tests of mdrender, with HTML output.
#
# mdrender reads its filters from pandoc's user data directory. The tests
# install this repository with install.sh --symlink into a temporary home and
# data directory, so they test the filters in this repository, not the
# installed ones.
#
# Covered:
#   - options: --help, --version, an unknown option, --output with several
#     inputs, and the error when the filters aren't installed;
#   - headings and title: one level-1 heading becomes the title, also after
#     HTML comments; several level-1 headings give a warning and no shift; a
#     heading in a fenced code block isn't counted; --no-shift;
#   - language: from a lang directive, YAML metadata, --lang and --gb;
#   - links: --link-ext rewrites relative .md links;
#   - input and output: stdin to stdout, and a file next to the input.
#
# Usage:
#   bats tests/mdrender.bats

bats_require_minimum_version 1.5.0

setup_file() {
  export HOME="${BATS_FILE_TMPDIR}/home"
  export XDG_DATA_HOME="${BATS_FILE_TMPDIR}/data"
  mkdir -p "${HOME}" "${BATS_FILE_TMPDIR}/root"
  "${BATS_TEST_DIRNAME}/../install.sh" --symlink --target "${BATS_FILE_TMPDIR}/root" >/dev/null
}

setup() {
  MDRENDER="${BATS_TEST_DIRNAME}/../bin/mdrender"
  cd "${BATS_TEST_TMPDIR}"
}

# Writes the text to doc.md, and renders it to HTML on stdout, with the given
# extra options. The output and status end up in Bats' $output, $stderr and
# $status.
render() {
  local text="$1"
  shift
  printf '%s' "${text}" > doc.md
  run --separate-stderr "${MDRENDER}" "$@" --output - doc.md
}

@test "--help shows the help" {
  run --separate-stderr "${MDRENDER}" --help
  [[ "${status}" -eq 0 ]]
  [[ "${lines[0]}" == "mdrender — render Markdown to HTML, DOCX, ODT or PDF, including diagrams" ]]
  [[ -z "${stderr}" ]]
}

@test "--version shows the version" {
  run --separate-stderr "${MDRENDER}" --version
  [[ "${status}" -eq 0 ]]
  [[ "${output}" =~ ^mdrender\ [0-9]+\.[0-9]+(_[0-9]+)?$ ]]
}

@test "an unknown option shows the usage, and fails" {
  run --separate-stderr "${MDRENDER}" --bogus doc.md
  [[ "${status}" -eq 1 ]]
  [[ "${stderr_lines[0]}" == "mdrender: unknown option: --bogus" ]]
  [[ "${stderr}" == *"Usage:"* ]]
}

@test "--output can't be used with several inputs" {
  printf '# A\n' > a.md
  printf '# B\n' > b.md
  run --separate-stderr "${MDRENDER}" --output out.html a.md b.md
  [[ "${status}" -eq 1 ]]
  [[ "${stderr}" == "mdrender: --output can only be used with a single input" ]]
}

@test "without installed filters, the error says to run install.sh" {
  XDG_DATA_HOME="${BATS_TEST_TMPDIR}/empty" render "# Title\n"
  [[ "${status}" -eq 1 ]]
  [[ "${stderr}" == *"not found in ${BATS_TEST_TMPDIR}/empty/pandoc/filters (run install.sh"* ]]
}

@test "a single level-1 heading becomes the title, and the other headings move up" {
  render $'# Title\n\nText\n\n## Part\n\n### Detail\n'
  [[ "${status}" -eq 0 ]]
  [[ "${output}" == *"<title>Title</title>"* ]]
  [[ "${output}" == *'<h1 class="title">Title</h1>'* ]]
  [[ "${output}" == *'<h1 id="part">Part</h1>'* ]]
  [[ "${output}" == *'<h2 id="detail">Detail</h2>'* ]]
  [[ -z "${stderr}" ]]
}

@test "HTML comments before the title keep it the title" {
  render $'<!-- lang: en-US -->\n<!-- Generated by a script. -->\n\n# Title\n\nText\n'
  [[ "${status}" -eq 0 ]]
  [[ "${output}" == *"<title>Title</title>"* ]]
  [[ "${output}" == *'<h1 class="title">Title</h1>'* ]]
  [[ "${output}" != *"<p>Title</p>"* ]]
}

@test "several level-1 headings give a warning, and no shift" {
  render $'# One\n\n# Two\n'
  [[ "${status}" -eq 0 ]]
  [[ "${stderr}" == "mdrender: doc: 2 level-1 headings found, not shifting heading levels" ]]
  [[ "${output}" == *'<h1 id="one">One</h1>'* ]]
  [[ "${output}" == *'<h1 id="two">Two</h1>'* ]]
  [[ "${output}" == *"<title>doc</title>"* ]]
}

@test "a level-1 heading in a fenced code block isn't counted" {
  render $'# Title\n\n```sh\n# a comment\n```\n'
  [[ "${status}" -eq 0 ]]
  [[ "${output}" == *'<h1 class="title">Title</h1>'* ]]
  [[ -z "${stderr}" ]]
}

@test "--no-shift keeps the heading levels, and the file name as page title" {
  render $'# Title\n\n## Part\n' --no-shift
  [[ "${status}" -eq 0 ]]
  [[ "${output}" == *'<h1 id="title">Title</h1>'* ]]
  [[ "${output}" == *'<h2 id="part">Part</h2>'* ]]
  [[ "${output}" == *"<title>doc</title>"* ]]
}

@test "a lang directive sets the HTML language" {
  render $'<!-- lang: nl -->\n\n# Titel\n'
  [[ "${status}" -eq 0 ]]
  [[ "${output}" == *'lang="nl"'* ]]
}

@test "YAML metadata wins over a lang directive" {
  render $'---\nlang: de\n---\n\n<!-- lang: nl -->\n\n# Titel\n'
  [[ "${output}" == *'lang="de"'* ]]
}

@test "--lang and --gb win over the document" {
  render $'---\nlang: de\n---\n\n# Title\n' --lang fr
  [[ "${output}" == *'lang="fr"'* ]]
  render $'<!-- lang: nl -->\n\n# Title\n' --gb
  [[ "${output}" == *'lang="en-GB"'* ]]
}

@test "--link-ext rewrites relative .md links, and leaves web links alone" {
  local text=$'# Title\n\n[other](other.md#part) and [web](https://example.com/page.md)\n'
  render "${text}" --link-ext
  [[ "${output}" == *'href="other.html#part"'* ]]
  [[ "${output}" == *'href="https://example.com/page.md"'* ]]
  render "${text}"
  [[ "${output}" == *'href="other.md#part"'* ]]
}

@test "input from stdin goes to stdout" {
  run --separate-stderr bash -c "printf '# Title\n' | '${MDRENDER}'"
  [[ "${status}" -eq 0 ]]
  [[ "${output}" == *"<title>Title</title>"* ]]
  [[ -z "${stderr}" ]]
}

@test "a file is written next to its input, and reported" {
  mkdir notes
  printf '# Title\n' > notes/plan.md
  run --separate-stderr "${MDRENDER}" notes/plan.md
  [[ "${status}" -eq 0 ]]
  [[ "${stderr}" == "mdrender: wrote notes/plan.html" ]]
  grep -q "<title>Title</title>" notes/plan.html
}
