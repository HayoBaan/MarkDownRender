#!/usr/bin/env bash

# mdrender — render Markdown to HTML, DOCX, ODT, or PDF, including diagrams
#
# Usage:
#   mdrender --help|-h
#   mdrender --version
#   mdrender [option...] [file.md ...] [-- extra pandoc options]
#
# Options:
#   --format|-f FORMAT    Output format: html (default), docx, odt or pdf.
#   --pdf|-p              Short for --format pdf.
#   --pdf-engine ENGINE   PDF engine: auto (default), typst, latex, weasyprint
#                         or libreoffice. The default can also be set with
#                         the environment variable MDRENDER_PDF_ENGINE.
#   --output|-o FILE      Output file, for a single input only. "-" means stdout.
#   --temp|-t             Write the output to a new temporary folder instead of
#                         next to the input or to stdout. The files are kept.
#   --open|-O             Open each output file in its default application.
#                         For input from stdin, this implies --temp.
#   --link-ext|-l         Rewrite relative .md links to the output extension,
#                         e.g. other.md#part becomes other.html#part. Not for
#                         pdf: there, links to other files become plain text.
#   --no-shift            Keep heading levels as they are.
#   --lang CODE           Document language, e.g. nl or en-GB. Sets hyphenation
#                         in PDF, the language for spell checking in docx/odt,
#                         and the lang attribute in HTML.
#   --nl, --de, --fr, --es, --gb
#                         Short for --lang nl (Dutch), de (German), fr (French),
#                         es (Spanish) or en-GB (British English).
#   --margin LENGTH       HTML page margin on all sides (default: 2em).
#   --max-width LENGTH    HTML content width limit (default: none, full width).
#   --theme THEME         HTML theme: light (default), dark, or system to follow
#                         the light or dark theme of the system. Printing is
#                         always light.
#   --dark                Short for --theme dark.
#   --paper SIZE          docx/odt/pdf paper size: a3, a4 (default), a5, letter,
#                         legal.
#   --landscape           docx/odt/pdf landscape orientation.
#   --page-margin LENGTH  docx/odt/pdf page margin on all sides (default: 2cm).
#                         Units: mm, cm, in or pt.
#   --reference-doc FILE  Style template for docx/odt, and for pdf with the
#                         libreoffice engine (fonts, styles, page setup).
#
# Without files, or with "-", input is read from stdin and written to stdout, or with --temp or
# --open to a temporary file named stdin.FORMAT. Short options can be combined (-tp is -t -p), and
# take an attached argument (-fodt is -f odt). Anything after "--" is passed to pandoc unchanged.
#
# Directives in the document, each an HTML comment on a line of its own:
#   <!-- lang: nl -->     Document language, unless --lang or YAML sets one.
#   <!-- newpage -->      Page break in docx, odt, pdf, and printed html.
#
# A paragraph that is only [[_TOC_]] or [TOC], as GitLab writes it, becomes a table of contents. So
# does a list between two <!-- TOC --> lines, as IntelliJ IDEA writes it. It is updated in the
# output only, with a warning when it was out of date. PDF, DOCX, and ODT get one with page numbers.
# For DOCX and ODT, LibreOffice fills it in, when it's installed.
#
# Examples:
#   mdrender advice.md plan.md --link-ext
#   mdrender -f odt advice.md
#   mdrender -f docx --landscape --paper a3 overview.md
#   mdrender -f pdf --pdf-engine weasyprint advice.md
#   mdrender -p --nl advies.md
#   mdrender --pdf --temp --open advice.md
#   cat notes.md | mdrender > notes.html
#   cat notes.md | mdrender --open
#
# How it works, and how to install it: README.md in the MarkDownRender repository,
# https://github.com/HayoBaan/MarkDownRender

set -euo pipefail

readonly PROGRAM="$(basename "$0")"
readonly VERSION="0.006"

# Prints the header comment of this script as its help
help() {
  sed -n '3,/^$/s/^# \{0,1\}//p' "$0"
}

# Prints the Usage part of the header comment
usage() {
  sed -n '/^# Usage:/,/^#$/s/^# \{0,1\}//p' "$0"
}

# Prints an error message and exits.
die() {
  echo "${PROGRAM}: $*" >&2
  exit 1
}

# Prints the full path of an installed filter, or exits when it is not installed.
find_filter() {
  local name="$1"
  local data_dir
  data_dir="$(pandoc --version | sed -n 's/^User data directory: //p')"
  local path="${data_dir}/filters/${name}"
  [[ -f "${path}" ]] || die "filter ${name} not found in ${data_dir}/filters (run install.sh from the MarkDownRender repository)"
  echo "${path}"
}

# Prints the full path of toc_update.py, the LibreOffice macro that fills in tables of contents, or
# exits when it is not installed.
find_toc_macro() {
  local data_dir
  data_dir="$(pandoc --version | sed -n 's/^User data directory: //p')"
  local path="${data_dir}/mdrender/toc_update.py"
  [[ -f "${path}" ]] || die "toc_update.py not found in ${data_dir}/mdrender (run install.sh from the MarkDownRender repository)"
  echo "${path}"
}

# Prints the number of level-1 headings outside fenced code blocks. Counts ATX headings ("# Title")
# and setext headings ("Title" over "=====").
count_h1() {
  awk '
    /^[[:space:]]*(```|~~~)/ { fence = !fence; previous = ""; next }
    fence { next }
    /^# / { count++ }
    /^=+[[:space:]]*$/ && previous ~ /[^[:space:]]/ { count++ }
    { previous = $0 }
    END { print count + 0 }
  ' "$1"
}

# Succeeds when the document starts with YAML metadata that sets a title.
has_yaml_title() {
  awk '
    NR == 1 && $0 !~ /^---[[:space:]]*$/ { exit 1 }
    NR > 1 && /^(---|\.\.\.)[[:space:]]*$/ { exit found ? 0 : 1 }
    NR > 1 && /^title:/ { found = 1 }
    END { exit found ? 0 : 1 }
  ' "$1"
}

format="html"
output=""
temp="false"
open_output="false"
link_ext="false"
shift_headings="true"
margin="2em"
max_width="none"
theme="light"
reference_doc=""
paper="a4"
landscape="false"
page_margin="2cm"
page_explicit="false"
lang=""
pdf_engine="${MDRENDER_PDF_ENGINE:-auto}"
inputs=()
pandoc_extra=()

# Process command-line options
case ${1:-} in
  --help|-h) help; exit 0 ;;
esac
while [[ $# -gt 0 ]]; do
  case "$1" in
    --version) echo "${PROGRAM} ${VERSION}"; exit 0 ;;
    -f | --format) format="${2:?missing format}"; shift 2 ;;
    -p | --pdf) format="pdf"; shift ;;
    --pdf-engine) pdf_engine="${2:?missing PDF engine}"; shift 2 ;;
    -o | --output) output="${2:?missing output file}"; shift 2 ;;
    -t | --temp) temp="true"; shift ;;
    -O | --open) open_output="true"; shift ;;
    -l | --link-ext) link_ext="true"; shift ;;
    --no-shift) shift_headings="false"; shift ;;
    --lang) lang="${2:?missing language}"; shift 2 ;;
    --nl | --de | --fr | --es) lang="${1#--}"; shift ;;
    --gb) lang="en-GB"; shift ;;
    --margin) margin="${2:?missing margin}"; shift 2 ;;
    --max-width) max_width="${2:?missing width}"; shift 2 ;;
    --theme) theme="${2:?missing theme}"; shift 2 ;;
    --dark) theme="dark"; shift ;;
    --reference-doc) reference_doc="${2:?missing file}"; shift 2 ;;
    --paper) paper="${2:?missing paper size}"; page_explicit="true"; shift 2 ;;
    --landscape) landscape="true"; page_explicit="true"; shift ;;
    --page-margin) page_margin="${2:?missing margin}"; page_explicit="true"; shift 2 ;;
    --) shift; pandoc_extra=("$@"); break ;;
    -) inputs+=("-"); shift ;;
    # A short option that takes an argument, with the argument attached: -fpdf is -f pdf
    -[fo]?*) set -- "${1:0:2}" "${1:2}" "${@:2}" ;;
    # Combined short options: -tp is -t -p
    -[!-]?*) set -- "${1:0:2}" "-${1:2}" "${@:2}" ;;
    -*) echo "${PROGRAM}: unknown option: $1" >&2; usage >&2; exit 1 ;;
    *) inputs+=("$1"); shift ;;
  esac
done

# Prints the program that runs a PDF engine, or fails when it is not installed.
pdf_program() {
  case "$1" in
    typst) command -v typst ;;
    latex) command -v xelatex || command -v lualatex || command -v tectonic || command -v pdflatex ;;
    weasyprint) command -v weasyprint ;;
    libreoffice) command -v soffice ;;
    *) return 1 ;;
  esac
}

# Prints the PDF engine to use: the one asked for, or with auto the first one installed.
choose_pdf_engine() {
  local engine
  case "${pdf_engine}" in
    auto)
      for engine in typst latex weasyprint libreoffice; do
        if pdf_program "${engine}" >/dev/null; then
          echo "${engine}"
          return
        fi
      done
      die "no PDF engine found (install e.g. typst, see the README)"
      ;;
    typst | latex | weasyprint | libreoffice)
      pdf_program "${pdf_engine}" >/dev/null || die "PDF engine ${pdf_engine} is not installed, or not on the PATH"
      echo "${pdf_engine}"
      ;;
    *) die "unsupported PDF engine ${pdf_engine} (use auto, typst, latex, weasyprint or libreoffice)" ;;
  esac
}

case "${format}" in
  html) writer="html5" ;;
  docx | odt) writer="${format}" ;;
  pdf)
    pdf_engine="$(choose_pdf_engine)"
    case "${pdf_engine}" in
      typst) writer="typst" ;;
      latex) writer="latex" ;;
      weasyprint) writer="html5" ;;
      libreoffice) writer="odt" ;;
    esac
    ;;
  *) die "unsupported format ${format} (use html, docx, odt or pdf)" ;;
esac

if [[ ${#inputs[@]} -eq 0 ]]; then
  inputs=("-")
fi
if [[ -n "${output}" && ${#inputs[@]} -gt 1 ]]; then
  die "--output can only be used with a single input"
fi
if [[ -n "${output}" && "${temp}" == "true" ]]; then
  die "--temp and --output cannot be combined"
fi
if [[ "${output}" == "-" && "${open_output}" == "true" ]]; then
  die "--open needs an output file, not stdout"
fi

# Prints the command that opens a file in its default application, or exits when there is none.
# Linux uses xdg-open, because some distributions have an unrelated command named open.
open_command() {
  case "$(uname -s)" in
    Darwin) echo "open" ;;
    *) command -v xdg-open || die "--open needs xdg-open, which is not installed" ;;
  esac
}

if [[ "${open_output}" == "true" ]]; then
  opener="$(open_command)"
fi

case "${paper}" in
  a3 | a4 | a5 | letter | legal) ;;
  *) die "unsupported paper size ${paper} (use a3, a4, a5, letter or legal)" ;;
esac

case "${theme}" in
  light | dark | system) ;;
  *) die "unsupported theme ${theme} (use light, dark or system)" ;;
esac

diagram_filter="$(find_filter diagram.lua)"
directives_filter="$(find_filter directives.lua)"
toc_filter="$(find_filter toc.lua)"
links_filter="$(find_filter md-links.lua)"
code_breaks_filter="$(find_filter code-breaks.lua)"
table_widths_filter="$(find_filter table-widths.lua)"

tmp_dir="$(mktemp -d)"
trap 'rm -rf "${tmp_dir}"' EXIT

# Writes a copy of a docx or odt reference document with the requested page setup. An odt also gets
# the paragraph style for page breaks. When the base is pandoc's built-in default, the copy also
# gets the look of the PDF: a serif font, its headings, and in a docx centered tables. A docx also
# gets the compatibility setting of Word 2013 or later, so Word doesn't open it in compatibility
# mode. Your own reference document keeps its own fonts and styles. Arguments: format, base
# document, output document, and whether the base is pandoc's default (true or false).
make_reference_doc() {
  python3 - "$1" "$2" "$3" "$4" "${paper}" "${landscape}" "${page_margin}" <<'PYTHON'
import re
import sys
import zipfile

fmt, base, out, pandoc_default, paper, landscape, margin = sys.argv[1:8]

# Paper sizes in millimeters, portrait.
SIZES = {"a3": (297, 420), "a4": (210, 297), "a5": (148, 210),
         "letter": (215.9, 279.4), "legal": (215.9, 355.6)}
UNIT_MM = {"mm": 1.0, "cm": 10.0, "in": 25.4, "pt": 25.4 / 72}

match = re.fullmatch(r"\s*([0-9]*\.?[0-9]+)\s*(mm|cm|in|pt)\s*", margin)
if not match:
    sys.exit(f"invalid page margin {margin!r} (use e.g. 2cm, 20mm, 1in or 72pt)")
margin_mm = float(match.group(1)) * UNIT_MM[match.group(2)]
width_mm, height_mm = SIZES[paper]
if landscape == "true":
    width_mm, height_mm = height_mm, width_mm
orientation = "landscape" if landscape == "true" else "portrait"

# The font for body text and headings, per format: a serif font, as in the PDF from Typst or LaTeX.
#   - docx: Cambria, which comes with Word. LibreOffice doesn't have it. It shows Caladea instead,
#     which comes with LibreOffice and has the same character widths, so a docx wraps the same way.
#   - odt: Caladea itself, so LibreOffice, the word processor of the format, shows a font it has.
FONT = {"docx": "Cambria", "odt": "Caladea"}[fmt]

# The headings of the PDF from Typst, scaled to the 12 pt text of pandoc's reference documents: all
# bold, none italic. The title is 1.5 times the text size, level 1 1.4 times, level 2 1.2 times, and
# deeper levels the text size. Each entry: font size in pt, space above in pt, space below in pt.
TITLE = (18, 0, 12)
HEADINGS = {1: (17, 14, 4), 2: (14, 12, 4)}
DEEPER_HEADING = (12, 10, 4)


def heading_format(level):
    """Returns the font size, space above, and space below in pt for a heading level."""
    return HEADINGS.get(level, DEEPER_HEADING)


def docx_page(xml):
    """Replaces the final section properties with the requested page setup."""
    twips = lambda mm: str(round(mm / 25.4 * 1440))
    page = (f'<w:pgSz w:w="{twips(width_mm)}" w:h="{twips(height_mm)}" w:orient="{orientation}"/>'
            f'<w:pgMar w:top="{twips(margin_mm)}" w:right="{twips(margin_mm)}" '
            f'w:bottom="{twips(margin_mm)}" w:left="{twips(margin_mm)}" '
            f'w:header="709" w:footer="709" w:gutter="0"/>')
    sections = list(re.finditer(r"<w:sectPr\b[^>]*?(?:/>|>.*?</w:sectPr>)", xml, re.S))
    if not sections:
        return xml.replace("</w:body>", f"<w:sectPr>{page}</w:sectPr></w:body>")
    last = sections[-1]
    section = re.sub(r"<w:(pgSz|pgMar)\b[^>]*/>", "", last.group(0))
    if section.endswith("/>"):
        section = section[:-2] + ">" + page + "</w:sectPr>"
    else:
        section = re.sub(r"(<w:sectPr\b[^>]*>)", lambda m: m.group(1) + page, section, count=1)
    return xml[:last.start()] + section + xml[last.end():]


def odt_page(xml):
    """Sets page size, orientation and margins on every page layout."""
    values = {"fo:page-width": f"{width_mm}mm", "fo:page-height": f"{height_mm}mm",
              "style:print-orientation": orientation,
              "fo:margin-top": f"{margin_mm}mm", "fo:margin-bottom": f"{margin_mm}mm",
              "fo:margin-left": f"{margin_mm}mm", "fo:margin-right": f"{margin_mm}mm"}

    def update(element):
        text = element.group(0)
        for name, value in values.items():
            pattern = rf'{name}="[^"]*"'
            if re.search(pattern, text):
                text = re.sub(pattern, f'{name}="{value}"', text)
            else:
                text = text.replace("<style:page-layout-properties",
                                    f'<style:page-layout-properties {name}="{value}"', 1)
        return text

    return re.sub(r"<style:page-layout-properties\b[^>]*>", update, xml)


# The paragraph style that directives.lua uses for a page break in ODT.
PAGEBREAK_STYLE = ('<style:style style:name="Pagebreak" style:family="paragraph" '
                   'style:parent-style-name="Standard">'
                   '<style:paragraph-properties fo:break-before="page"/></style:style>')


def odt_fonts(xml):
    """Sets FONT in the default paragraph style and the Standard style, which the others build on."""
    face = (f'<style:font-face style:name="{FONT}" svg:font-family="{FONT}" '
            'style:font-family-generic="roman" style:font-pitch="variable"/>')
    if f'style:font-face style:name="{FONT}"' not in xml:
        xml = xml.replace("</office:font-face-decls>", face + "</office:font-face-decls>", 1)

    def set_font(style):
        return re.sub(r'\bstyle:font-name="[^"]*"', f'style:font-name="{FONT}"', style.group(0))

    xml = re.sub(r'<style:default-style style:family="paragraph">.*?</style:default-style>',
                 set_font, xml, count=1, flags=re.S)
    return re.sub(r'<style:style style:name="Standard"[^>]*>.*?</style:style>', set_font, xml,
                  count=1, flags=re.S)


def set_attributes(tag, values):
    """Returns an opening XML tag with the attributes set, replaced or added."""
    for name, value in values.items():
        pattern = rf'\b{re.escape(name)}="[^"]*"'
        if re.search(pattern, tag):
            tag = re.sub(pattern, f'{name}="{value}"', tag)
        else:
            tag = re.sub(r"\s*(/?>)$", f' {name}="{value}"\\1', tag)
    return tag


def odt_heading(style, size_pt, above_pt, below_pt):
    """Returns an ODT paragraph style with the format of a heading: bold, not italic, the size, and
    the space above and below."""
    margins = {"fo:margin-top": f"{above_pt}pt", "fo:margin-bottom": f"{below_pt}pt"}
    text = {}
    for suffix in ("", "-asian", "-complex"):
        prefix = "fo:" if suffix == "" else "style:"
        text[f"{prefix}font-size{suffix}"] = f"{size_pt}pt"
        text[f"{prefix}font-weight{suffix}"] = "bold"
        text[f"{prefix}font-style{suffix}"] = "normal"
    for element, values in (("paragraph-properties", margins), ("text-properties", text)):
        pattern = rf"<style:{element}\b[^>]*>"
        if re.search(pattern, style):
            style = re.sub(pattern, lambda match: set_attributes(match.group(0), values), style,
                           count=1)
        else:
            # Paragraph properties come before text properties, which come last.
            follower = "<style:text-properties" if element == "paragraph-properties" else ""
            if not follower or follower not in style:
                follower = "</style:style>"
            style = style.replace(follower,
                                  set_attributes(f"<style:{element}/>", values) + follower, 1)
    return style


def odt_headings(xml):
    """Gives the title and the headings the format of the PDF, see TITLE and HEADINGS."""
    xml = re.sub(r'<style:style style:name="Title"[^>]*>.*?</style:style>',
                 lambda match: odt_heading(match.group(0), *TITLE), xml, count=1, flags=re.S)
    return re.sub(r'<style:style style:name="Heading_20_(\d+)"[^>]*>.*?</style:style>',
                  lambda match: odt_heading(match.group(0), *heading_format(int(match.group(1)))),
                  xml, flags=re.S)


def odt_styles(xml):
    """Sets the page setup, and the font and headings when the base is pandoc's default. Adds the
    Pagebreak style when it is missing."""
    xml = odt_page(xml)
    if pandoc_default == "true":
        xml = odt_headings(odt_fonts(xml))
    if 'style:name="Pagebreak"' not in xml:
        xml = xml.replace("</office:styles>", PAGEBREAK_STYLE + "</office:styles>", 1)
    return xml


def docx_heading(style, size_pt, above_pt, below_pt):
    """Returns a docx paragraph style with the format of a heading: black, bold, not italic, the
    size, and the space above and below. Word wants run properties in the order of its schema: bold
    after the fonts, the size after the color."""
    def paragraph(match):
        return re.sub(r"<w:spacing\b[^>]*/>",
                      lambda spacing: set_attributes(spacing.group(0), {
                          "w:before": str(above_pt * 20), "w:after": str(below_pt * 20)}),
                      match.group(0), count=1)

    def run(match):
        properties = re.sub(r"<w:(?:b|bCs|i|iCs|color|sz|szCs)\b[^>]*/>", "", match.group(0))
        bold = "<w:b/><w:bCs/>"
        if "<w:rFonts" in properties:
            properties = re.sub(r"(<w:rFonts\b[^>]*/>)", lambda fonts: fonts.group(1) + bold,
                                properties, count=1)
        else:
            properties = properties.replace("<w:rPr>", "<w:rPr>" + bold, 1)
        size = f'<w:sz w:val="{size_pt * 2}"/><w:szCs w:val="{size_pt * 2}"/>'
        return properties.replace("</w:rPr>", size + "</w:rPr>", 1)

    style = re.sub(r"<w:pPr>.*?</w:pPr>", paragraph, style, count=1, flags=re.S)
    if "<w:rPr>" not in style:
        style = style.replace("</w:style>", "<w:rPr></w:rPr></w:style>", 1)
    return re.sub(r"<w:rPr>.*?</w:rPr>", run, style, count=1, flags=re.S)


def docx_styles(xml):
    """Gives the title and headings the format of the PDF, and centers tables, as in ODT and PDF.

    Pandoc's heading styles copy Word's: dark blue or gray, not bold, and level 4 italic. They get
    the format of TITLE and HEADINGS instead. Tables get the alignment of the Table style that pandoc
    uses.
    """
    xml = re.sub(r'<w:style\b[^>]*\bw:styleId="Title"[^>]*>.*?</w:style>',
                 lambda match: docx_heading(match.group(0), *TITLE), xml, count=1, flags=re.S)
    xml = re.sub(r'<w:style\b[^>]*\bw:styleId="Heading([1-9])"[^>]*>.*?</w:style>',
                 lambda match: docx_heading(match.group(0), *heading_format(int(match.group(1)))),
                 xml, flags=re.S)

    def center(style):
        text = style.group(0)
        if "<w:jc " in text:
            return text
        if "<w:tblPr>" in text:
            return text.replace("<w:tblPr>", '<w:tblPr><w:jc w:val="center"/>', 1)
        return text.replace("</w:style>", '<w:tblPr><w:jc w:val="center"/></w:tblPr></w:style>', 1)

    return re.sub(r'<w:style\b[^>]*\bw:styleId="Table"[^>]*>.*?</w:style>', center, xml,
                  count=1, flags=re.S)


# The compatibility setting that a document of Word 2013 or later has. Without it, Word opens a docx
# in compatibility mode, and pandoc's reference document lacks it.
DOCX_COMPAT = ('<w:compat><w:compatSetting w:name="compatibilityMode" '
               'w:uri="http://schemas.microsoft.com/office/word" w:val="15"/></w:compat>')


def docx_settings(xml):
    """Adds DOCX_COMPAT when the settings have no compat element. Word wants the settings in the
    order of its schema: compat comes before rsids and themeFontLang."""
    if "<w:compat" in xml:
        return xml
    for follower in ("<w:docVars", "<w:rsids", "<w:themeFontLang", "</w:settings>"):
        if follower in xml:
            return xml.replace(follower, DOCX_COMPAT + follower, 1)
    return xml


def docx_theme(xml):
    """Sets FONT as the theme's fonts for headings (major) and body text (minor)."""
    return re.sub(r'(<a:(?:major|minor)Font>\s*<a:latin typeface=")[^"]*"',
                  lambda match: match.group(1) + FONT + '"', xml)


if fmt == "docx":
    transforms = {"word/document.xml": docx_page}
    if pandoc_default == "true":
        transforms.update({"word/styles.xml": docx_styles, "word/theme/theme1.xml": docx_theme,
                           "word/settings.xml": docx_settings})
else:
    transforms = {"styles.xml": odt_styles}
with zipfile.ZipFile(base) as source, zipfile.ZipFile(out, "w") as target:
    for info in source.infolist():
        data = source.read(info.filename)
        if info.filename in transforms:
            data = transforms[info.filename](data.decode("utf-8")).encode("utf-8")
        # ODT requires an uncompressed mimetype entry, which keeping the original compression preserves.
        target.writestr(info, data, compress_type=info.compress_type)
PYTHON
}

# Prints pandoc options that limit diagrams to the text area of the current paper, orientation, and
# margin. The height leaves 20mm for a caption.
diagram_size_options() {
  python3 - "${paper}" "${landscape}" "${page_margin}" <<'PYTHON'
import re
import sys

CAPTION_MM = 20

paper, landscape, margin = sys.argv[1:4]
sizes = {"a3": (297, 420), "a4": (210, 297), "a5": (148, 210),
         "letter": (215.9, 279.4), "legal": (215.9, 355.6)}
unit_mm = {"mm": 1.0, "cm": 10.0, "in": 25.4, "pt": 25.4 / 72}
match = re.fullmatch(r"\s*([0-9]*\.?[0-9]+)\s*(mm|cm|in|pt)\s*", margin)
if not match:
    sys.exit(f"invalid page margin {margin!r} (use e.g. 2cm, 20mm, 1in or 72pt)")
margin_mm = float(match.group(1)) * unit_mm[match.group(2)]
width, height = sizes[paper]
if landscape == "true":
    width, height = height, width
print("--metadata")
print(f"diagram-max-width={width - 2 * margin_mm:.1f}mm")
print("--metadata")
print(f"diagram-max-height={height - 2 * margin_mm - CAPTION_MM:.1f}mm")
PYTHON
}

# Prints the reference document to use for docx or odt, creating it when needed.
# Argument: the document format, docx or odt.
reference_doc_for() {
  local doc_format="$1"
  local generated="${tmp_dir}/reference.${doc_format}"
  if [[ -f "${generated}" ]]; then
    echo "${generated}"
    return
  fi
  local base="${reference_doc}"
  if [[ -n "${base}" && "${page_explicit}" == "false" ]]; then
    echo "${base}"
    return
  fi
  local pandoc_default="false"
  if [[ -z "${base}" ]]; then
    local data_dir
    data_dir="$(pandoc --version | sed -n 's/^User data directory: //p')"
    base="${data_dir}/reference.${doc_format}"
    if [[ ! -f "${base}" ]]; then
      base="${tmp_dir}/default-reference.${doc_format}"
      pandoc --print-default-data-file "reference.${doc_format}" > "${base}"
      pandoc_default="true"
    fi
  fi
  [[ -f "${base}" ]] || die "reference document ${base} not found"
  make_reference_doc "${doc_format}" "${base}" "${generated}" "${pandoc_default}" \
    || die "could not create the page setup"
  echo "${generated}"
}

# Writes the CSS for the HTML theme, and prints its path.
#   - Pandoc's template picks its colors with light-dark(), so the color-scheme property selects the
#     theme. Without it, the template follows the system. The template itself keeps printing light.
#   - Diagrams are drawn for a light background. They get a light panel, which is only visible on a
#     dark page.
theme_css() {
  local file="${tmp_dir}/theme.html"
  local scheme=""
  case "${theme}" in
    light | dark) scheme="@media screen { html { color-scheme: ${theme}; } }" ;;
  esac
  cat > "${file}" <<CSS
<style>
${scheme}
img.diagram {
  box-sizing: border-box;
  padding: 0.5em;
  border-radius: 0.4em;
  background-color: light-dark(transparent, #fdfdfd);
}
</style>
CSS
  echo "${file}"
}

# Writes the CSS for WeasyPrint, and prints its path:
#   - The page setup, as an @page rule.
#   - Task list checkboxes on the line of their item. WeasyPrint's own style sheet makes a checkbox
#     a block with padding, so it sits on a line of its own, larger than pandoc's style intends. In
#     a bulleted task list, pandoc's own rule is more specific and places the checkbox where the
#     bullet is.
#   - The table of contents from toc.lua without bullets, and with dot leaders and page numbers.
page_css() {
  local file="${tmp_dir}/page.html"
  local size="${paper}"
  case "${paper}" in
    a3 | a4 | a5) size="$(echo "${paper}" | tr a A)" ;;
  esac
  [[ "${landscape}" == "true" ]] && size+=" landscape"
  cat > "${file}" <<CSS
<style>
@page { size: ${size}; margin: ${page_margin}; }
li input[type="checkbox"] {
  display: inline-block;
  box-sizing: border-box;
  width: 0.8em;
  height: 0.8em;
  padding: 0.15em;
  margin: 0 0.4em 0 0;
  vertical-align: -0.25em;
}
.toc ul { list-style: none; padding-left: 1.5em; }
.toc > ul { padding-left: 0; }
.toc a::after { content: leader(".") target-counter(attr(href url), page); }
</style>
CSS
  echo "${file}"
}

# Writes the page setup for pandoc's Typst template as metadata, and prints its path. The template
# takes the margin as a map, which only a metadata file can set.
typst_page_metadata() {
  local file="${tmp_dir}/typst-page.yaml"
  local size="${paper}"
  case "${paper}" in
    letter | legal) size="us-${paper}" ;;
  esac
  printf 'papersize: %s\nmargin:\n  x: %s\n  y: %s\n' "${size}" "${page_margin}" "${page_margin}" > "${file}"
  echo "${file}"
}

# Writes Typst rules that improve pandoc's tables, and prints their path:
#   - Pandoc centers each table, and its cells inherit that. Cells start left.
#   - Pandoc's template justifies all text. In narrow cells that leaves gaps.
#   - The header row is bold, as in the other output formats.
#   - Pandoc wraps a table in a figure, which Typst keeps on one page. A breakable figure lets a
#     long table continue on the next page, and its header row is repeated there.
typst_table_rules() {
  local file="${tmp_dir}/tables.typ"
  cat > "${file}" <<'TYPST'
#show table: set align(start)
#show table: set par(justify: false)
#show table.cell.where(y: 0): set text(weight: "bold")
#show figure.where(kind: table): set block(breakable: true)
TYPST
  echo "${file}"
}

# Writes Typst rules for task list checkboxes, and prints their path. Pandoc writes a task list item
# as a bullet item that starts with ☐ or ☒.
#   - Typst's default font has neither glyph, so the fallback font picks them, and on macOS ☐
#     becomes a box with a question mark. The rules show the math symbols □ and ⊠ instead, as pandoc
#     does for LaTeX. Typst's math font always has them.
#   - In a list of only task items, the checkbox replaces the bullet, as in the HTML. Typst gives
#     all items of a list the same marker, so such a list becomes an enum whose numbering returns
#     each item's checkbox.
typst_task_list_rules() {
  local file="${tmp_dir}/task-lists.typ"
  cat > "${file}" <<'TYPST'
#let task-marks = ("☐": $square.stroked$, "☒": $times.square$)

// Splits a task list item into its checkbox and the rest of its body.
// Returns none for an item that does not start with a checkbox.
#let task-split(item) = {
  let body = item.body
  let children = if body.has("children") { body.children } else { (body,) }
  let first = children.at(0, default: none)
  if first == none or not first.has("text") { return none }
  let chars = first.text.codepoints()
  if chars.len() == 0 or chars.first() not in task-marks { return none }
  let rest = chars.slice(1).join(default: "").trim(at: start)
  let tail = children.slice(1)
  if rest == "" and tail.len() > 0 and tail.first() == [ ] { tail = tail.slice(1) }
  (task-marks.at(chars.first()), (if rest == "" { none } else { text(rest) }, ..tail).join())
}

// Returns the list marker one nesting level deeper than the given one.
#let deeper-marker(marker) = {
  if type(marker) == array { marker.slice(1) + marker.slice(0, 1) }
  else if type(marker) == function { depth => marker(depth + 1) }
  else { marker }
}

// Typst counts list depth only through lists, so the lists nested in the
// enum get the next level's marker explicitly.
#show list: it => {
  let tasks = it.children.map(task-split)
  if tasks.any(t => t == none) { return it }
  context {
    set list(marker: deeper-marker(list.marker))
    enum(
      tight: it.tight,
      spacing: it.spacing,
      numbering: n => tasks.at(n - 1).first(),
      ..tasks.map(t => enum.item(t.last())),
    )
  }
}

#show "☐": $square.stroked$
#show "☒": $times.square$
TYPST
  echo "${file}"
}

# Writes LaTeX line breaking settings, and prints their path. LaTeX prefers a line that runs past
# the margin over a loose line. A long inline code name, which it cannot hyphenate, then runs off
# the page. \sloppy accepts the loose line instead.
latex_line_rules() {
  local file="${tmp_dir}/lines.tex"
  echo '\sloppy' > "${file}"
  echo "${file}"
}

# Writes the LaTeX code font as metadata, and prints its path, or fails when the LaTeX in use has no
# DejaVu Sans Mono. LaTeX's default code font, Latin Modern Mono, has no box-drawing characters such
# as ├── and │, and LaTeX has no font fallback, so they are left out. DejaVu Sans Mono has them.
# Tectonic downloads it, and a full TeX Live includes it, but BasicTeX does not. pdflatex cannot use
# it at all. A metadata file lets a monofont in the document's own metadata win.
latex_font_metadata() {
  local program
  program="$(basename "$(pdf_program latex)")"
  case "${program}" in
    tectonic) ;;
    pdflatex) return 1 ;;
    *) kpsewhich DejaVuSansMono.ttf >/dev/null 2>&1 || return 1 ;;
  esac
  local file="${tmp_dir}/latex-fonts.yaml"
  printf 'monofont: DejaVuSansMono.ttf\nmonofontoptions: Scale=MatchLowercase\n' > "${file}"
  echo "${file}"
}

# Runs toc_update.py in LibreOffice, which updates the tables of contents of a DOCX or ODT. In mode
# pdf it exports the document as PDF. In mode fill it writes the document with its tables of
# contents filled in, and otherwise as pandoc wrote it. Arguments: mode, input, output. Fails when
# LibreOffice writes no output. It reports a failing macro only that way.
#
# A private user profile lets LibreOffice run while it is open, and holds the macro. The macro reads
# its arguments from the environment, as a macro URL has none. LibreOffice's messages, such as font
# configuration warnings, go to libreoffice.log in the temporary folder.
libreoffice_toc_update() {
  local mode="$1" input="$2" output="$3"
  local scripts="${tmp_dir}/libreoffice/user/Scripts/python"
  mkdir -p "${scripts}"
  cp "$(find_toc_macro)" "${scripts}/toc_update.py"
  rm -f "${output}"
  MDRENDER_TOC_MODE="${mode}" MDRENDER_TOC_INPUT="${input}" MDRENDER_TOC_OUTPUT="${output}" \
    "$(pdf_program libreoffice)" -env:UserInstallation="file://${tmp_dir}/libreoffice" \
    --headless --invisible 'vnd.sun.star.script:toc_update.py$update?language=Python&location=user' \
    >"${tmp_dir}/libreoffice.log" 2>&1 || true
  [[ -f "${output}" ]]
}

# Draws a line under the header row of each table in an ODT, as DOCX and PDF have. Pandoc writes the
# style of a header cell, TableHeaderRowCell, into the document itself, without a border. A
# reference document can't change it. Argument: the ODT, which is changed in place.
style_odt_tables() {
  python3 - "$1" <<'PYTHON'
import os
import re
import sys
import zipfile

path = sys.argv[1]
BORDERS = ('fo:border-top="none" fo:border-left="none" fo:border-right="none" '
           'fo:border-bottom="0.5pt solid #000000"')


def header_border(match):
    """Replaces the borders of the header cell style's properties."""
    attributes = re.sub(r'\s*fo:border(?:-[a-z]+)?="[^"]*"', "", match.group(2))
    return match.group(1) + attributes + " " + BORDERS + match.group(3)


temporary = path + ".tmp"
with zipfile.ZipFile(path) as source, zipfile.ZipFile(temporary, "w") as target:
    for info in source.infolist():
        data = source.read(info.filename)
        if info.filename == "content.xml":
            data = re.sub(r'(<style:style style:name="TableHeaderRowCell"[^>]*>\s*'
                          r'<style:table-cell-properties)([^>]*?)(\s*/?>)',
                          header_border, data.decode("utf-8")).encode("utf-8")
        # ODT requires an uncompressed mimetype entry, which keeping the original compression preserves.
        target.writestr(info, data, compress_type=info.compress_type)
os.replace(temporary, path)
PYTHON
}

# Succeeds when a DOCX or ODT that pandoc wrote has a table of contents from toc.lua.
has_toc() {
  python3 - "$1" <<'PYTHON'
import sys
import zipfile

path = sys.argv[1]
with zipfile.ZipFile(path) as archive:
    if path.endswith(".docx"):
        found = b"<w:instrText xml:space=\"preserve\">TOC " in archive.read("word/document.xml")
    else:
        found = b"<text:table-of-content" in archive.read("content.xml")
sys.exit(0 if found else 1)
PYTHON
}

# Fills in the tables of contents of a DOCX or ODT with LibreOffice. Pandoc leaves them empty, and
# only Word or LibreOffice can work out the page numbers. Without LibreOffice, or when it fails, the
# document stays as it is, with a warning. Arguments: document, name for messages.
fill_toc() {
  local document="$1" name="$2"
  has_toc "${document}" || return 0
  local later="it stays empty until it is updated in LibreOffice"
  [[ "${format}" == "docx" ]] && later="Word fills it in when it updates the fields"
  if ! pdf_program libreoffice >/dev/null; then
    echo "${PROGRAM}: ${name}: LibreOffice not found, so the table of contents is empty: ${later}" >&2
    return 0
  fi
  local filled="${tmp_dir}/output/filled.${format}"
  if libreoffice_toc_update fill "${document}" "${filled}"; then
    mv "${filled}" "${document}"
  else
    cat "${tmp_dir}/libreoffice.log" >&2
    echo "${PROGRAM}: ${name}: LibreOffice could not fill in the table of contents: ${later}" >&2
  fi
}

# Writes a finished file to its target: stdout for "-", or the target file.
deliver() {
  local file="$1" target="$2"
  if [[ "${target}" == "-" ]]; then
    cat "${file}"
  else
    mv "${file}" "${target}"
  fi
}

# Adds the table widths filter to the pandoc options of render(), in its args array, with the text
# width of the page. It takes that width from the diagram size options, in its diagram_size array.
add_table_widths() {
  local option
  for option in "${diagram_size[@]}"; do
    if [[ "${option}" == diagram-max-width=* ]]; then
      args+=(
        --lua-filter "${table_widths_filter}"
        --metadata "table-text-width=${option#diagram-max-width=}"
      )
    fi
  done
}

# Renders one input file to the given output ("-" for stdout).
render() {
  local input="$1" target="$2" name="$3" resource_dir="$4"

  local args=(
    "${input}"
    --from markdown+gfm_auto_identifiers
    --to "${writer}"
    --standalone
    --resource-path "${resource_dir}"
    --lua-filter "${directives_filter}"
    --lua-filter "${toc_filter}"
    --lua-filter "${diagram_filter}"
    --lua-filter "${code_breaks_filter}"
  )

  # Limits for diagram images, which only formats with pages need.
  local diagram_size=() sizes line
  if [[ "${format}" != "html" ]]; then
    sizes="$(diagram_size_options)" || die "${name}: invalid page setup"
    while IFS= read -r line; do
      diagram_size+=("${line}")
    done <<< "${sizes}"
  fi

  local h1_count
  h1_count="$(count_h1 "${input}")"
  if [[ "${shift_headings}" == "true" ]] && has_yaml_title "${input}"; then
    # The YAML metadata sets the title, so the level-1 headings stay headings. A shift would turn
    # them into plain paragraphs.
    :
  elif [[ "${shift_headings}" == "true" && "${h1_count}" -eq 1 ]]; then
    # Filters run before the shift, so the table of contents filter must leave out the title itself.
    args+=(--shift-heading-level-by=-1 --metadata toc-skip-title=true)
  elif [[ "${shift_headings}" == "true" && "${h1_count}" -gt 1 ]]; then
    echo "${PROGRAM}: ${name}: ${h1_count} level-1 headings found, not shifting heading levels" >&2
  fi

  if [[ "${format}" == "pdf" ]]; then
    # Most PDF viewers refuse to open another file from a link, so links to other local files become
    # plain text. Web links and internal links stay.
    args+=(--lua-filter "${links_filter}" --metadata "md-link-unlink=true")
  elif [[ "${link_ext}" == "true" ]]; then
    args+=(--lua-filter "${links_filter}" --metadata "md-link-ext=${format}")
  fi

  # Overrides a lang field in the document's YAML metadata, and a lang directive.
  if [[ -n "${lang}" ]]; then
    args+=(--metadata "lang=${lang}")
  fi

  case "${writer}" in
    html5)
      if [[ "${format}" == "html" ]]; then
        args+=(
          --embed-resources
          --variable "maxwidth=${max_width}"
          --variable "margin-left=${margin}"
          --variable "margin-right=${margin}"
          --variable "margin-top=${margin}"
          --variable "margin-bottom=${margin}"
          --include-in-header "$(theme_css)"
        )
      else
        # WeasyPrint: the page setup comes from CSS, so the body needs no width limit or padding of
        # its own.
        args+=(
          --variable "maxwidth=none"
          --variable "margin-left=0"
          --variable "margin-right=0"
          --variable "margin-top=0"
          --variable "margin-bottom=0"
          --include-in-header "$(page_css)"
          --metadata "diagram-format=png"
          "${diagram_size[@]}"
          # Hides warnings about CSS in pandoc's template that only browsers support.
          --pdf-engine-opt=--quiet
        )
      fi
      # Without a title, pandoc warns and the browser tab shows nothing useful.
      if [[ ! ( "${shift_headings}" == "true" && "${h1_count}" -eq 1 ) ]] && ! has_yaml_title "${input}"; then
        args+=(--metadata "pagetitle=${name}")
      fi
      ;;
    docx | odt)
      # Pandoc gives a wide pipe table fixed relative column widths, taken from the lengths of its
      # dash lines. A short header such as "Datum" then breaks within the word. With a wide line
      # limit, pandoc gives no widths, and the table widths filter sets them from the content. Word
      # and LibreOffice would otherwise give all columns the same width.
      args+=(--reference-doc "$(reference_doc_for "${writer}")" --columns=10000)
      # Keeps diagrams and tables within the text area. With an unmodified own reference document
      # the page setup is unknown, so diagrams keep their natural size, and tables get equal
      # columns.
      if [[ -z "${reference_doc}" || "${page_explicit}" == "true" ]]; then
        args+=("${diagram_size[@]}")
        add_table_widths
      fi
      ;;
    typst)
      # Typst reads a path that starts with / relative to its root folder, which is the current
      # folder by default. Pandoc refers to images by absolute path.
      args+=(
        --metadata-file "$(typst_page_metadata)"
        "${diagram_size[@]}"
        --pdf-engine-opt=--root=/
        # Typst reads the color as content, in which # starts code.
        --variable 'linkcolor=\#1a5fb4'
        --include-in-header "$(typst_table_rules)"
        --include-in-header "$(typst_task_list_rules)"
        # Pandoc gives a wide pipe table relative column widths, taken from the lengths of its dash
        # lines. A wide line limit leaves the widths to Typst, which fits them to the content.
        --columns=10000
      )
      # Pandoc's Typst template has no variable for the orientation.
      if [[ "${landscape}" == "true" ]]; then
        echo '#set page(flipped: true)' > "${tmp_dir}/landscape.typ"
        args+=(--include-in-header "${tmp_dir}/landscape.typ")
      fi
      ;;
    latex)
      args+=(
        --variable "papersize=${paper}"
        --variable "geometry=margin=${page_margin}"
        --variable "colorlinks=true"
        --variable "linkcolor=Blue"
        --include-in-header "$(latex_line_rules)"
        "${diagram_size[@]}"
      )
      if [[ "${landscape}" == "true" ]]; then
        args+=(--variable "geometry=landscape")
      fi
      local font_metadata
      if font_metadata="$(latex_font_metadata)"; then
        args+=(--metadata-file "${font_metadata}")
      fi
      # Widens table columns that are too narrow for their longest word. It runs after the code
      # breaks filter, whose break opportunities it counts.
      add_table_widths
      ;;
  esac

  if [[ "${target}" == "-" && "${format}" != "html" && -t 1 ]]; then
    die "${name}: refusing to write ${format} to a terminal (use --output, --temp or --open, or redirect stdout)"
  fi

  if [[ "${format}" == "html" ]]; then
    pandoc "${args[@]}" ${pandoc_extra[@]+"${pandoc_extra[@]}"} --output "${target}"
    return
  fi

  mkdir -p "${tmp_dir}/output"
  if [[ "${format}" != "pdf" ]]; then
    # A DOCX or ODT is written to a temporary file first, to fill in its table of contents.
    local document="${tmp_dir}/output/${name}.${format}"
    pandoc "${args[@]}" ${pandoc_extra[@]+"${pandoc_extra[@]}"} --output "${document}"
    [[ "${format}" == "odt" ]] && style_odt_tables "${document}"
    fill_toc "${document}" "${name}"
    deliver "${document}" "${target}"
    return
  fi

  # Pandoc only creates a PDF for an output file named *.pdf, and LibreOffice always writes to a
  # folder. Both write to a temporary file first.
  local pdf="${tmp_dir}/output/${name}.pdf"
  if [[ "${pdf_engine}" == "libreoffice" ]]; then
    local odt="${tmp_dir}/output/${name}.odt"
    pandoc "${args[@]}" ${pandoc_extra[@]+"${pandoc_extra[@]}"} --output "${odt}"
    style_odt_tables "${odt}"
    # A plain conversion leaves a table of contents empty, so toc_update.py updates it first. A
    # private user profile lets the conversion run while LibreOffice is open. Its messages, such as
    # font configuration warnings, are only shown on failure.
    if has_toc "${odt}"; then
      if ! libreoffice_toc_update pdf "${odt}" "${pdf}"; then
        cat "${tmp_dir}/libreoffice.log" >&2
        die "${name}: LibreOffice could not convert the document to PDF"
      fi
    elif ! "$(pdf_program libreoffice)" -env:UserInstallation="file://${tmp_dir}/libreoffice" \
      --headless --convert-to pdf --outdir "${tmp_dir}/output" "${odt}" \
      >"${tmp_dir}/libreoffice.log" 2>&1 || [[ ! -f "${pdf}" ]]; then
      cat "${tmp_dir}/libreoffice.log" >&2
      die "${name}: LibreOffice could not convert the document to PDF"
    fi
  else
    # Tectonic warns about every image that pandoc refers to by absolute path. That is harmless
    # here, so those warnings are left out. Other messages remain.
    pandoc "${args[@]}" --pdf-engine "$(pdf_program "${pdf_engine}")" \
      ${pandoc_extra[@]+"${pandoc_extra[@]}"} --output "${pdf}" \
      2> >(grep -v '^warning: accessing absolute path .*build may not be reproducible' >&2)
  fi
  deliver "${pdf}" "${target}"
}

# The folder for --temp output. It is created on first use, and kept after mdrender exits, so the
# files can still be opened.
temp_output_dir=""

for input in "${inputs[@]}"; do
  if [[ "${input}" == "-" ]]; then
    input_file="${tmp_dir}/stdin.md"
    cat > "${input_file}"
    name="stdin"
    resource_dir="${PWD}"
  else
    [[ -f "${input}" ]] || die "${input}: no such file"
    input_file="${input}"
    name="$(basename "${input%.*}")"
    resource_dir="$(dirname "${input}")"
  fi

  if [[ -n "${output}" ]]; then
    target="${output}"
  elif [[ "${temp}" == "true" || ( "${input}" == "-" && "${open_output}" == "true" ) ]]; then
    if [[ -z "${temp_output_dir}" ]]; then
      temp_base="${TMPDIR:-/tmp}"
      temp_output_dir="$(mktemp -d "${temp_base%/}/mdrender.XXXXXX")"
    fi
    target="${temp_output_dir}/${name}.${format}"
  elif [[ "${input}" == "-" ]]; then
    target="-"
  else
    target="${input%.*}.${format}"
  fi

  render "${input_file}" "${target}" "${name}" "${resource_dir}"
  if [[ "${target}" != "-" ]]; then
    echo "${PROGRAM}: wrote ${target}" >&2
  fi
  if [[ "${open_output}" == "true" ]]; then
    "${opener}" "${target}"
  fi
done
